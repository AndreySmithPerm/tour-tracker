# Travelpayouts API
TRAVELPAYOUTS_API_TOKEN=your_api_token_here
TRAVELPAYOUTS_MARKER=your_marker_here
TRAVELPAYOUTS_TRS=your_trs_id_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database
DB_NAME=tour_tracker
DB_USER=tour_tracker_user
DB_PASSWORD=change_me_to_secure_password
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?sslmode=disable

# Server
HTTP_PORT=8080

# Worker
CHECK_INTERVAL_MINUTES=60

# Domain (меняется без переписывания кода)
DOMAIN=example.com
BOT_URL=https://t.me/your_bot_username
BOT_HANDLE=@your_bot_username
SITE_URL=https://example.com

# Yandex Captcha
YANDEX_CAPTCHA_SITE_KEY=your_site_key
YANDEX_CAPTCHA_SECRET=your_secret_key

# S3 Backup
S3_BUCKET=tour-tracker-backups
S3_ENDPOINT=https://s3.yandexcloud.net
S3_ACCESS_KEY=your_s3_key
S3_SECRET_KEY=your_s3_secret
